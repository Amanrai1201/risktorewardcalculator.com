---
import { formatNumber } from '../../../lib/format';

interface Props {
  /** Break-even win rate as a fraction of 1, or null when the setup is not calculable. */
  breakEven: number | null;
  /** Server-rendered break-even percentage. */
  breakEvenLabel: string;
  /** The visitor's own win rate, 0–100. */
  winRatePercent: number;
  /** Server-rendered expectancy in money, and the class that carries its sign. */
  expectancyLabel: string;
  expectancyTone: string;
  /** Server-rendered expectancy in R multiples, brackets included. */
  expectancyRLabel: string;
}

const {
  breakEven,
  breakEvenLabel,
  winRatePercent,
  expectancyLabel,
  expectancyTone,
  expectancyRLabel,
} = Astro.props;

/**
 * The break-even win rate means little on its own. Drawn as a track split into a
 * losing zone and a profitable one, with the visitor's own win rate marked on
 * it, it answers the real question at a glance: does this setup pay off at the
 * rate I actually win?
 */
const breakEvenPct = breakEven == null ? 0 : Math.min(Math.max(breakEven, 0), 1) * 100;
const winRatePct = Math.min(Math.max(winRatePercent, 0), 100);
---

<div class="rounded-md border border-hairline bg-surface-1 p-3">
  <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
    <p class="text-eyebrow uppercase text-ink-subtle">Expected outcome</p>
    <p class="flex items-center gap-2 text-body-sm text-ink-muted">
      <label for="rr-winrate">Your win rate</label>
      <span class="relative inline-flex items-center">
        <input
          id="rr-winrate"
          name="wr"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          value={winRatePercent}
          aria-describedby="rr-winrate-unit"
          class="figures h-9 w-16 rounded-md border border-hairline-strong bg-canvas py-0 pl-2 pr-6 text-right text-body text-ink outline-none hover:border-ink-tertiary focus-visible:border-accent"
        />
        <span
          id="rr-winrate-unit"
          class="pointer-events-none absolute right-2 text-body-sm text-ink-subtle"
        >
          %
        </span>
      </span>
    </p>
  </div>

  <div class="mt-3">
    <div class="relative h-2.5 overflow-hidden rounded-full bg-gain-bar/25" aria-hidden="true">
      <span
        class="block h-full bg-loss-bar/35 transition-[width] duration-150 ease-out"
        style={`width:${breakEvenPct.toFixed(1)}%`}
        data-bar="breakeven"
      ></span>
      <span
        class="absolute inset-y-0 w-0.5 -translate-x-1/2 rounded-full bg-ink transition-[left] duration-150 ease-out"
        style={`left:${winRatePct.toFixed(1)}%`}
        data-marker="winrate"
      ></span>
    </div>

    <div class="mt-1.5 flex items-baseline justify-between gap-3 text-caption text-ink-subtle">
      <span>
        Break-even{' '}
        <span class="figures font-semibold text-ink-muted" data-field="netBreakEven">
          {breakEvenLabel}
        </span>
      </span>
      <span>
        Your rate{' '}
        <span class="figures font-semibold text-ink-muted" data-field="winRateLabel">
          {formatNumber(winRatePct, 'INR', { maxDecimals: 1 })}%
        </span>
      </span>
    </div>
  </div>

  <p class="mt-3 flex flex-wrap items-baseline gap-x-2 border-t border-hairline pt-3">
    <span class:list={['figures text-figure', expectancyTone]} data-field="expectancyMoney">
      {expectancyLabel}
    </span>
    <span class="figures text-body-sm text-ink-muted" data-field="expectancyR">
      {expectancyRLabel}
    </span>
    <span class="text-body-sm text-ink-subtle">per trade on average</span>
  </p>
</div>
