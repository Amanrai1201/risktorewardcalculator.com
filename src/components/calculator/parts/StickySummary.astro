---
interface Props {
  ratio: string;
  netReward: string;
  netRisk: string;
}

const { ratio, netReward, netRisk } = Astro.props;

/**
 * Mobile-only summary that stays in view while the form is filled in, so the
 * answer never scrolls away. Sticky rather than fixed, so it can never sit on
 * top of the on-screen keyboard or the field being typed into.
 */
---

<div class="sticky top-0 z-20 -mx-4 mb-1 border-b border-hairline bg-canvas px-4 py-2 sm:-mx-6 sm:px-6 lg:hidden">
  <div class="flex items-baseline justify-between gap-3">
    <p class="min-w-0">
      <span class="text-caption text-ink-subtle">Net R:R</span>
      <span class="figures ml-1.5 text-figure-sm text-ink" data-field="netRatio">
        {ratio}
      </span>
    </p>
    <p class="flex min-w-0 items-baseline gap-2 text-caption">
      <span class="figures text-figure-sm text-gain" data-field="netReward">
        {netReward}
      </span>
      <span class="text-ink-tertiary" aria-hidden="true">
        /
      </span>
      <span class="figures text-figure-sm text-loss" data-field="netRisk">
        {netRisk}
      </span>
    </p>
  </div>
</div>
