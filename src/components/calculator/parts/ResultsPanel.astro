---
import type { CurrencyCode, NetResult } from '../../../lib/calc/types';
import { expectancyInMoney, expectancyInR } from '../../../lib/calc/risk-reward';
import {
  formatMoney,
  formatPercent,
  formatRatio,
  formatRatioShort,
  formatSignedMoney,
} from '../../../lib/format';
import { resultSummary, verdictTone, verdictWord, VERDICT_CHIP_CLASSES } from '../../../lib/notes';
import Card from '../../ui/Card.astro';
import Callout from '../../ui/Callout.astro';
import StatTile from '../../ui/StatTile.astro';
import Button from '../../ui/Button.astro';
import RiskRewardBar from './RiskRewardBar.astro';
import WinRateMeter from './WinRateMeter.astro';

interface Props {
  result: NetResult;
  currency: CurrencyCode;
  /** "share" for equity, "unit" for forex. */
  unitLabel: string;
  winRatePercent: number;
}

const { result, currency, unitLabel, winRatePercent } = Astro.props;
const { gross } = result;

const winFraction = winRatePercent / 100;
const expectancy = expectancyInMoney(result.netReward, result.netRisk, winFraction);
const expectancyR = result.netRatio != null ? expectancyInR(result.netRatio, winFraction) : null;

const riskShare =
  result.netRisk + result.netReward > 0
    ? result.netRisk / (result.netRisk + result.netReward)
    : 0.5;

const chargeDrag = gross.grossReward > 0 ? result.chargesAtTarget.total / gross.grossReward : null;

const summary = resultSummary(result, currency);

/**
 * A reward wiped out by charges has no ratio to quote, but the verdict is not
 * neutral — it is weak, so it is judged as a ratio of zero.
 */
const verdictRatio = result.chargesExceedReward ? 0 : result.netRatio;
const tone = verdictTone(verdictRatio);

/** Signed money, so profit and loss are told apart before the colour is read. */
const netRewardLabel = formatSignedMoney(result.netReward, currency);
const netRiskLabel = formatSignedMoney(-result.netRisk, currency);

/** Expectancy is the one figure whose colour flips with its sign. */
const expectancyTone =
  expectancy == null || expectancy === 0
    ? 'text-ink-muted'
    : expectancy > 0
      ? 'text-gain'
      : 'text-loss';
---

<Card title="Your result" subtitle="Recalculates as you type. Charges included.">
  {/* The verdict, as a chip rather than a sentence. */}
  <span
    slot="header"
    class:list={[
      'inline-flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 text-caption font-semibold',
      VERDICT_CHIP_CLASSES[tone],
    ]}
    data-verdict-badge
    data-verdict={tone}
  >
    <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
    <span data-field="verdictLabel">{verdictWord(verdictRatio)}</span>
  </span>

  <div class="space-y-5">
    <div class="grid grid-cols-2 gap-3">
      <StatTile
        label="Net risk : reward"
        value={formatRatio(result.netRatio)}
        hint={`Gross ${formatRatio(gross.ratio)}`}
        hintField="grossRatio"
        field="netRatio"
        size="lg"
        tone="accent"
        emphasis
      />
      <StatTile
        label="Break-even win rate"
        value={formatPercent(result.netBreakEvenWinRate)}
        hint="of trades must win"
        field="netBreakEven"
        size="lg"
        emphasis
      />
    </div>

    <RiskRewardBar riskShare={riskShare} riskValue={netRiskLabel} rewardValue={netRewardLabel} />

    {/*
      The figures above carry the answer visually. This is the same answer as one
      sentence for screen readers — the single live region, so nothing is
      announced twice.
    */}
    <p role="status" aria-live="polite" class="sr-only" data-field="summary" data-verdict={tone}>
      {summary}
    </p>

    {/* Gross → charges → net, spelled out for both outcomes. */}
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-md border border-hairline bg-surface-1 p-3">
        <p class="text-eyebrow uppercase text-gain">If target hits</p>
        <dl class="mt-2 space-y-1.5 text-body-sm">
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-ink-muted">Gross profit</dt>
            <dd class="figures text-ink" data-field="grossReward">
              {formatMoney(gross.grossReward, currency)}
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-ink-muted">Charges</dt>
            <dd class="figures text-loss" data-field="chargesAtTarget">
              −{formatMoney(result.chargesAtTarget.total, currency)}
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-3 border-t border-hairline pt-1.5">
            <dt class="font-semibold text-ink">Net profit</dt>
            <dd class="figures text-figure text-gain" data-field="netReward">
              {netRewardLabel}
            </dd>
          </div>
        </dl>
      </div>

      <div class="rounded-md border border-hairline bg-surface-1 p-3">
        <p class="text-eyebrow uppercase text-loss">If stop hits</p>
        <dl class="mt-2 space-y-1.5 text-body-sm">
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-ink-muted">Gross loss</dt>
            <dd class="figures text-ink" data-field="grossRisk">
              {formatMoney(gross.grossRisk, currency)}
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-ink-muted">Charges</dt>
            <dd class="figures text-loss" data-field="chargesAtStop">
              +{formatMoney(result.chargesAtStop.total, currency)}
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-3 border-t border-hairline pt-1.5">
            <dt class="font-semibold text-ink">Net loss</dt>
            <dd class="figures text-figure text-loss" data-field="netRisk">
              {netRiskLabel}
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <StatTile
        label={`Risk per ${unitLabel}`}
        labelField="riskPerUnitLabel"
        value={formatMoney(gross.riskPerUnit, currency)}
        field="riskPerUnit"
        size="sm"
        emphasis
      />
      <StatTile
        label={`Reward per ${unitLabel}`}
        labelField="rewardPerUnitLabel"
        value={formatMoney(gross.rewardPerUnit, currency)}
        field="rewardPerUnit"
        size="sm"
        emphasis
      />
      <StatTile
        label="Position value"
        labelField="notionalLabel"
        value={formatMoney(gross.entryValue, currency, { decimals: 0 })}
        field="entryValue"
        size="sm"
        emphasis
      />
      <StatTile
        label="Charges at target"
        labelField="chargeDragLabel"
        value={formatMoney(result.chargesAtTarget.total, currency)}
        field="totalAtTarget"
        hint={`${formatPercent(chargeDrag, { decimals: 2 })} of gross profit`}
        hintField="chargeDrag"
        size="sm"
        emphasis
      />
    </div>

    <WinRateMeter
      breakEven={result.netBreakEvenWinRate}
      breakEvenLabel={formatPercent(result.netBreakEvenWinRate)}
      winRatePercent={winRatePercent}
      expectancyLabel={formatSignedMoney(expectancy, currency)}
      expectancyTone={expectancyTone}
      expectancyRLabel={`(${expectancyR != null && expectancyR > 0 ? '+' : ''}${formatRatioShort(
        expectancyR != null ? Math.abs(expectancyR) : null,
      )})`}
    />

    <Callout tone="warn" title="Charges swallow this trade" field="chargesWarning" hidden>
      Estimated charges are larger than the profit at your target, so this setup loses money even
      when it works. Widen the target, add size, or switch to a cheaper segment.
    </Callout>

    <Callout tone="warn" title="Check your inputs" field="issues" hidden>
      <ul class="list-disc space-y-1 pl-4" data-field="issuesList"></ul>
    </Callout>
  </div>

  <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-hairline pt-4">
    <Button variant="secondary" size="sm" data-action="copy-result">
      Copy result
    </Button>
    <Button variant="secondary" size="sm" data-action="copy-link">
      Copy link
    </Button>
    <Button variant="ghost" size="sm" data-action="reset">
      Reset
    </Button>
    <p
      class="text-caption text-ink-subtle"
      role="status"
      aria-live="polite"
      data-field="actionStatus"
    ></p>
  </div>
</Card>
