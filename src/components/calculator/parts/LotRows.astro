---
import type { PurchaseLot } from '../../../lib/calc/stock-average';
import LotRow from './LotRow.astro';

interface Props {
  lots: PurchaseLot[];
  symbol: string;
}

const { lots, symbol } = Astro.props;

/**
 * The list of purchases.
 *
 * Rows are added and removed by `src/scripts/stock-average.ts`, which clones the
 * `<template>` below rather than building markup in JavaScript — one definition
 * of a row, so a server-rendered row and a freshly added one cannot drift apart.
 */
const removable = lots.length > 1;

/** Rows with a blank price or quantity never reach the average, so they are not counted. */
const counted = lots.filter((lot) => lot.price > 0 && lot.quantity > 0).length;
---

<div data-lots>
  <div
    class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] gap-2 text-body-sm font-medium text-ink"
    aria-hidden="true"
  >
    <span>Buy price</span>
    <span>Quantity</span>
    <span class="w-9"></span>
  </div>

  <div class="mt-1.5 space-y-2" data-lot-list>
    {lots.map((lot, i) => (
      <LotRow
        price={lot.price}
        quantity={lot.quantity}
        index={i + 1}
        symbol={symbol}
        removable={removable}
      />
    ))}
  </div>

  <p class="mt-1.5 text-caption text-loss" data-field="lotError" hidden></p>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <button
      type="button"
      data-action="add-lot"
      class="inline-flex min-h-9 items-center gap-1.5 rounded-md border border-hairline-strong bg-canvas px-3 text-body-sm font-medium text-ink transition-colors duration-150 hover:bg-surface-1 active:bg-surface-2"
    >
      <span aria-hidden="true">+</span> Add a purchase
    </button>

    <p class="text-caption text-ink-subtle">
      <span class="figures text-ink-muted" data-field="lotsUsed">
        {counted}
      </span>{' '}
      purchases counted
    </p>
  </div>
</div>

{/* Cloned for every purchase added. Inert until then. */}
<template data-lot-template>
  <LotRow index={0} symbol={symbol} />
</template>
