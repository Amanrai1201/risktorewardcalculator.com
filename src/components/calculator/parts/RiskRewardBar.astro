---
interface Props {
  /** Risk as a share of risk + reward, 0–1. */
  riskShare: number;
  /** Net loss, server-rendered and signed. */
  riskValue: string;
  /** Net profit, server-rendered and signed. */
  rewardValue: string;
}

const { riskShare, riskValue, rewardValue } = Astro.props;

/**
 * Two bars on one scale rather than one split bar: the pair shows how much
 * bigger the reward is than the risk, which is the whole point of the ratio.
 * Both are measured against the larger of the two, so the winning side always
 * fills its track and the losing side reads as a fraction of it.
 */
const clamped = Math.min(Math.max(riskShare, 0), 1);
const peak = Math.max(clamped, 1 - clamped) || 1;
const riskPct = Math.round((clamped / peak) * 100);
const rewardPct = Math.round(((1 - clamped) / peak) * 100);
---

<div>
  <p class="text-eyebrow uppercase text-ink-subtle">Risk vs reward</p>

  {/* One grid, so both bars and both figures share their column widths. */}
  <div class="mt-2 grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2">
    <span class="text-caption text-ink-muted">Risk</span>
    <span class="h-2.5 overflow-hidden rounded-full bg-surface-2" aria-hidden="true">
      <span
        class="block h-full rounded-full bg-loss-bar transition-[width] duration-150 ease-out"
        style={`width:${riskPct}%`}
        data-bar="risk"
      ></span>
    </span>
    <span class="figures text-right text-body-sm font-semibold text-loss" data-field="netRisk">
      {riskValue}
    </span>

    <span class="text-caption text-ink-muted">Reward</span>
    <span class="h-2.5 overflow-hidden rounded-full bg-surface-2" aria-hidden="true">
      <span
        class="block h-full rounded-full bg-gain-bar transition-[width] duration-150 ease-out"
        style={`width:${rewardPct}%`}
        data-bar="reward"
      ></span>
    </span>
    <span class="figures text-right text-body-sm font-semibold text-gain" data-field="netReward">
      {rewardValue}
    </span>
  </div>
</div>
