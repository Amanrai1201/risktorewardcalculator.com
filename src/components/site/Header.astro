---
import { NAV_LINKS } from '../../data/site';

const here = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---

<header class="border-b border-hairline bg-canvas">
  <div class="container-page flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:py-4">
    <a
      href="/"
      class="inline-flex w-fit items-center rounded-xs text-card-title font-semibold tracking-tight text-ink"
    >
      <img src="/risk.png" alt="Risk Reward Calculator" class="h-8 w-auto" />
      <span class="ml-1.5 text-body-sm font-normal text-ink-subtle">Calculator</span>
    </a>

    <nav aria-label="Calculators" class="-mx-1 overflow-x-auto sm:mx-0 sm:overflow-visible">
      <ul class="flex items-center gap-0.5 sm:gap-1">
        {NAV_LINKS.map((link) => {
          const current = isCurrent(link.href);
          return (
            <li class="shrink-0">
              <a
                href={link.href}
                aria-current={current ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center rounded-md px-2.5 text-body-sm whitespace-nowrap transition-colors duration-150 sm:px-3',
                  current
                    ? 'font-semibold text-ink'
                    : 'text-ink-muted hover:bg-surface-1 hover:text-ink',
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
