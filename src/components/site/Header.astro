---
import { NAV_LINKS } from '../../data/site';
import ThemeToggle from './ThemeToggle.astro';
import BookmarkButton from './BookmarkButton.astro';

const here = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---

<header class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/95 backdrop-blur-md transition-colors">
  <div class="container-page flex items-center justify-between gap-x-3 py-2.5 sm:py-3">
    
    <!-- Brand / Logo -->
    <a
      href="/"
      class="inline-flex shrink-0 items-center rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
      aria-label="Risk Reward Calculator Home"
    >
      <img
        src="/risk.png"
        alt="Risk Reward Calculator"
        class="h-7 w-auto sm:h-8"
        width="32"
        height="32"
        loading="eager"
      />
      <span class="ml-1.5 text-body-sm font-medium tracking-tight text-ink-subtle">
        Calculator
      </span>
    </a>
    <nav aria-label="Calculators" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {NAV_LINKS.map((link) => {
          const current = isCurrent(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={current ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center rounded-md px-3 text-body-sm transition-colors duration-150',
                  current
                    ? 'font-semibold text-ink bg-surface-1'
                    : 'text-ink-muted hover:bg-surface-1 hover:text-ink',
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

 
    <div class="flex items-center gap-1 sm:gap-2">
      <BookmarkButton />
      <ThemeToggle />


      <button
        type="button"
        id="mobile-menu-toggle"
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-ink-muted hover:bg-surface-1 hover:text-ink lg:hidden focus-visible:outline-2 focus-visible:outline-ink"
        aria-expanded="false"
        aria-controls="mobile-shutter-menu"
        aria-label="Toggle navigation menu"
      >
        <svg id="menu-icon-open" class="h-6 w-6 stroke-current transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-6 w-6 stroke-current transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
  <div
    id="mobile-shutter-menu"
    class="grid grid-rows-[0fr] overflow-hidden border-t border-hairline bg-canvas transition-[grid-template-rows] duration-300 ease-in-out lg:hidden"
    aria-label="Mobile Navigation"
  >
    <div class="min-h-0">
      <nav class="container-page py-3">
        <ul class="flex flex-col gap-1">
          {NAV_LINKS.map((link) => {
            const current = isCurrent(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={current ? 'page' : undefined}
                  class:list={[
                    'flex min-h-11 items-center rounded-md px-3 text-body-sm transition-colors duration-150',
                    current
                      ? 'font-semibold text-ink bg-surface-1'
                      : 'text-ink-muted hover:bg-surface-1 hover:text-ink',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  function setupShutterMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const shutterMenu = document.getElementById('mobile-shutter-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!toggleBtn || !shutterMenu || !iconOpen || !iconClose) return;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));

      if (isExpanded) {
        shutterMenu.classList.remove('grid-rows-[1fr]');
        shutterMenu.classList.add('grid-rows-[0fr]');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      } else {
        shutterMenu.classList.remove('grid-rows-[0fr]');
        shutterMenu.classList.add('grid-rows-[1fr]');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      }
    });
  }

  // Initial load + Astro View Transitions support
  setupShutterMenu();
  document.addEventListener('astro:page-load', setupShutterMenu);
</script>