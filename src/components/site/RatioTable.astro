---
import { requiredWinRate } from '../../lib/calc/risk-reward';
import { formatPercent, formatRatio } from '../../lib/format';

/**
 * Reward-to-risk against the win rate it needs to break even.
 *
 * The percentages come from the same `requiredWinRate` the calculator uses, so
 * this reference table can never contradict the tool above it.
 */

const ROWS = [
  { ratio: 0.5, note: 'Two wins in three, just to stay flat.' },
  { ratio: 1, note: 'Better than a coin flip, consistently.' },
  { ratio: 1.5, note: 'Two wins in five keeps you level.' },
  { ratio: 2, note: 'One win in three keeps you level.' },
  { ratio: 2.5, note: 'Two wins in seven keeps you level.' },
  { ratio: 3, note: 'One win in four keeps you level.' },
  { ratio: 4, note: 'One win in five keeps you level.' },
  { ratio: 5, note: 'One win in six keeps you level.' },
];

const rows = ROWS.map((row) => ({
  label: formatRatio(row.ratio),
  winRate: formatPercent(requiredWinRate(row.ratio)),
  note: row.note,
}));

const headClass = 'py-2 pr-4 text-left text-caption font-semibold uppercase text-ink-subtle';
---

<div class="max-w-prose overflow-x-auto">
  <table class="w-full border-collapse text-body-sm">
    <caption class="sr-only">
      Reward-to-risk ratios and the win rate each one needs to break even
    </caption>
    <thead>
      <tr class="border-b border-hairline-strong">
        <th scope="col" class={headClass}>
          Risk : reward
        </th>
        <th scope="col" class={headClass}>
          Break-even win rate
        </th>
        <th scope="col" class={`${headClass} pr-0`}>
          In practice
        </th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="border-b border-hairline">
          <th scope="row" class="figures py-2.5 pr-4 text-left font-semibold text-ink">
            {row.label}
          </th>
          <td class="figures py-2.5 pr-4 whitespace-nowrap text-ink">{row.winRate}</td>
          <td class="py-2.5 text-ink-muted">{row.note}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p class="mt-3 max-w-prose text-caption text-ink-subtle">
  These are gross figures. Brokerage and taxes push every row a little higher, which is what the net
  break-even win rate in the calculator shows.
</p>
