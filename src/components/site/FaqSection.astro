---
import type { Faq } from '../../data/faqs';
import Chevron from '../ui/Chevron.astro';

/**
 * Native `<details>` accordion. No JavaScript, no layout shift, and the
 * questions stay in the document outline as real headings. The same array is
 * passed to `faqPage()` for the structured data, so the two cannot drift.
 */

interface Props {
  faqs: Faq[];
  title?: string;
  id?: string;
}

const { faqs, title = 'Common questions', id = 'faq' } = Astro.props;

const summaryClass =
  'flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-3 [&::-webkit-details-marker]:hidden';
const chevronClass =
  'size-5 shrink-0 text-ink-subtle transition-transform duration-150 group-open:-rotate-180';
---

<section {id} class="border-t border-hairline">
  <div class="container-page py-16 sm:py-20">

    <!-- Heading -->
    <h2 class="text-center text-display-md">
      {title}
    </h2>

    <!-- FAQ List -->
    <div class="mx-auto mt-12 max-w-4xl space-y-4">

      {faqs.map((faq) => (
        <details
          class="group rounded-xl border border-gray-200  shadow-sm"
        >
          <summary
            class="flex cursor-pointer list-none items-center justify-between px-6 py-6 text-body font-medium"
          >
            <h3 class="text-ink">
              {faq.question}
            </h3>

            <Chevron
              class="ml-4 h-5 w-5 shrink-0 text-gray-500 transition-transform duration-200 group-open:rotate-180"
            />
          </summary>

          <div class="px-6 pb-6">
            <p class="text-body-sm leading-6 text-ink-muted">
              {faq.answer}
            </p>
          </div>
        </details>
      ))}

    </div>
  </div>
</section>