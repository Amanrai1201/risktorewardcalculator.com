---
import type { HTMLAttributes } from 'astro/types';

/**
 * A page section: hairline rule, page gutter, heading, optional lead.
 * Every long-form block on the site uses this so the vertical rhythm and
 * heading sizes stay identical across pages.
 */

interface Props extends HTMLAttributes<'section'> {
  title: string;
  /** Anchor id, so the section can be linked to directly. */
  id?: string;
  /** One or two sentences under the heading. */
  lead?: string;
  /** Tinted background, used to separate adjacent sections. */
  tone?: 'canvas' | 'surface';
}

const { title, id, lead, tone = 'canvas', class: className, ...rest } = Astro.props;
---

<section
  {id}
  class:list={['border-t border-hairline', tone === 'surface' && 'bg-surface-1', className]}
  {...rest}
>
  <div class="container-page py-10 sm:py-14">
    <h2 class="text-display-md">{title}</h2>
    {lead && <p class="mt-3 max-w-prose text-body-lg text-ink-muted">{lead}</p>}
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>
