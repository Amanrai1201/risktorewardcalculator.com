---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost';

interface Props extends HTMLAttributes<'button'>, HTMLAttributes<'a'> {
  variant?: Variant;
  size?: 'sm' | 'md';
  /** Renders an anchor when set. */
  href?: string;
}

const { variant = 'secondary', size = 'md', href, type, class: className, ...rest } = Astro.props;

const Tag = href ? 'a' : 'button';

const VARIANTS: Record<Variant, string> = {
  primary: 'bg-primary text-on-primary hover:bg-primary-hover active:bg-primary-press',
  secondary:
    'border border-hairline-strong bg-canvas text-ink hover:bg-surface-1 active:bg-surface-2',
  ghost: 'text-ink-muted hover:bg-surface-1 hover:text-ink',
};

const SIZES = {
  sm: 'min-h-9 px-3 text-body-sm',
  md: 'min-h-11 px-4 text-body-sm',
};
---

<Tag
  {href}
  type={href ? undefined : (type ?? 'button')}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md font-medium whitespace-nowrap',
    'transition-colors duration-150',
    VARIANTS[variant],
    SIZES[size],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
