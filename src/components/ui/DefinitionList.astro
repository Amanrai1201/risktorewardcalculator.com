---
interface Props {
  items: { term: string; detail: string }[];
  variant?: 'prose' | 'formula';
}

const { items, variant = 'prose' } = Astro.props;

const detailClass =
  variant === 'formula'
    ? 'mt-1.5 rounded-sm bg-surface-1 px-2.5 py-1.5 text-body-sm text-ink'
    : 'mt-0.5 text-body-sm leading-5 text-ink-muted';
---

<dl class="grid gap-x-8 gap-y-0 sm:grid-cols-2">
  {items.map((item) => (
    <div class="border-b border-hairline py-3 first:pt-0 sm:nth-child(-n+2):pt-0 last:border-b-0">
      <dt class="text-body-sm font-medium text-ink">
        {item.term}
      </dt>

      <dd class={detailClass}>
        {item.detail}
      </dd>
    </div>
  ))}
</dl>