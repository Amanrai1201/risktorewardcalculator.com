---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/site/Section.astro';
import RelatedCalculators from '../../components/site/RelatedCalculators.astro';
import { ARTICLES, CATEGORY_COLORS, getArticle } from '../../data/articles';
import { articleSchema, breadcrumbs, faqPage } from '../../lib/schema';
import { renderMarkdown } from '../../lib/markdown';

export const getStaticPaths = (() => {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const article = getArticle(slug);

if (!article) {
  return Astro.redirect('/404');
}

const colors = CATEGORY_COLORS[article.category] ?? { bg: 'bg-surface-2', text: 'text-ink-subtle' };

const bodyHtml = renderMarkdown(article.body);

const jsonLd = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Articles', path: '/articles/' },
    { name: article.title, path: `/articles/${article.slug}/` },
  ]),
  articleSchema(article),
  faqPage(article.faqs),
];

// Related articles — same category, excluding current
const related = ARTICLES.filter(
  (a) => a.slug !== article.slug && a.category === article.category,
).slice(0, 2);
const otherArticles =
  related.length > 0 ? related : ARTICLES.filter((a) => a.slug !== article.slug).slice(0, 2);
---

<BaseLayout
  title={article.metaTitle}
  description={article.metaDescription}
  path={`/articles/${article.slug}/`}
  {jsonLd}
>
  <!-- Hero / breadcrumb -->
  <section class="container-page pt-8 pb-6 sm:pt-10 sm:pb-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-5">
      <ol class="flex flex-wrap items-center gap-1.5 text-caption text-ink-subtle">
        <li>
          <a href="/" class="hover:text-ink transition-colors duration-150">
            Home
          </a>
        </li>
        <li aria-hidden="true" class="text-ink-tertiary">
          /
        </li>
        <li>
          <a href="/articles/" class="hover:text-ink transition-colors duration-150">
            Articles
          </a>
        </li>
        <li aria-hidden="true" class="text-ink-tertiary">
          /
        </li>
        <li class="text-ink-muted truncate max-w-[200px] sm:max-w-none">{article.title}</li>
      </ol>
    </nav>

    <div class="max-w-prose">
      <span
        class:list={[
          'inline-block px-2 py-0.5 rounded-xs text-caption font-semibold mb-4',
          colors.bg,
          colors.text,
        ]}
      >
        {article.category}
      </span>
      <h1 class="text-display-lg">{article.title}</h1>
      <p class="mt-3 text-body-lg text-ink-muted">{article.metaDescription}</p>
      <p class="mt-3 text-caption text-ink-subtle">
        Published{' '}
        <time datetime={article.datePublished}>
          {new Date(article.datePublished).toLocaleDateString('en-IN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </p>
    </div>
  </section>

  <!-- Article body -->
  <section class="container-page pb-10">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
      <!-- Main content -->
      <article id="article-content" class="panel p-5 sm:p-8 max-w-none prose-article">
        <div set:html={bodyHtml} />
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <!-- Article info -->
        <div class="panel p-5">
          <h2 class="text-eyebrow uppercase text-ink-subtle tracking-wider mb-3">
            About this article
          </h2>
          <dl class="space-y-2 text-body-sm">
            <div class="flex gap-2">
              <dt class="text-ink-subtle shrink-0 w-20">Category</dt>
              <dd class:list={['font-semibold', colors.text]}>{article.category}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="text-ink-subtle shrink-0 w-20">Published</dt>
              <dd class="text-ink-muted figures">
                {new Date(article.datePublished).toLocaleDateString('en-IN', {
                  year: 'numeric',
                  month: 'short',
                })}
              </dd>
            </div>
          </dl>
        </div>

        <!-- Related articles -->
        {otherArticles.length > 0 && (
          <div class="panel p-5">
            <h2 class="text-eyebrow uppercase text-ink-subtle tracking-wider mb-3">
              More Articles
            </h2>
            <ul class="space-y-3">
              {otherArticles.map((rel) => (
                <li>
                  <a href={`/articles/${rel.slug}/`} class="group block">
                    <span class="text-body-sm font-semibold text-ink group-hover:text-accent transition-colors duration-150">
                      {rel.title}
                    </span>
                    <span class="mt-0.5 block text-caption text-ink-subtle">{rel.category}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a
              href="/articles/"
              class="mt-4 flex items-center gap-1 text-caption font-semibold text-accent hover:text-accent-hover transition-colors duration-150"
            >
              All articles
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M3 8h10M9 4l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>
        )}

        <!-- Calculator CTA -->
        <div class="panel p-5 bg-primary/5 border-primary/20">
          <h2 class="text-card-title text-ink font-semibold mb-2">Calculate Your True R:R</h2>
          <p class="text-body-sm text-ink-muted mb-4">
            Put the numbers from this article into our free calculator to see your actual net
            risk-to-reward after all charges.
          </p>
          <a
            href="/"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-primary text-on-primary text-body-sm font-semibold hover:bg-primary-hover active:bg-primary-press transition-colors duration-150"
          >
            Open Calculator
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M3 8h10M9 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- FAQ Section -->
  {article.faqs.length > 0 && (
    <section id="faq" class="border-t border-hairline">
      <div class="container-page py-10 sm:py-14">
        <h2 class="text-display-md">Frequently Asked Questions</h2>
        <div class="mt-6 max-w-prose space-y-4">
          {article.faqs.map((faq, i) => (
            <details class="panel p-5 group" id={`faq-${i + 1}`}>
              <summary class="flex cursor-pointer items-start justify-between gap-4 text-card-title font-semibold text-ink list-none [&::-webkit-details-marker]:hidden">
                <span>{faq.question}</span>
                <svg
                  class="mt-0.5 size-5 shrink-0 text-ink-subtle transition-transform duration-200 group-open:rotate-180"
                  viewBox="0 0 20 20"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M5 7.5L10 12.5L15 7.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <p class="mt-3 text-body-sm text-ink-muted leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <Section
    id="calculators"
    title="Free Trading Calculators"
    lead="Apply what you learned with our free tools."
    tone="surface"
  >
    <RelatedCalculators />
  </Section>
</BaseLayout>

<style>
  /* Article prose styles scoped to this page */
  .prose-article :global(p + p) {
    margin-top: 1rem;
  }
  .prose-article :global(h2),
  .prose-article :global(h3),
  .prose-article :global(h4) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-article :global(blockquote) {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .prose-article :global(table) {
    font-size: 0.875rem;
  }
  .prose-article :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
