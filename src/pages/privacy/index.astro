---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/site/Section.astro';
import Card from '../../components/ui/Card.astro';
import { breadcrumbs } from '../../lib/schema';

const title = 'Privacy Policy | Risk Reward Calculator';
const description =
  'Our Privacy Policy guarantees 100% client-side calculation privacy. None of your stock prices, trade inputs, or financial data ever leave your device.';

const jsonLd = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Privacy Policy', path: '/privacy/' },
  ]),
];
---

<BaseLayout {title} {description} path="/privacy/" {jsonLd}>
  <section class="container-page pt-8 pb-10 sm:pt-10 sm:pb-12">
    <div class="max-w-prose">
      <h1 class="text-display-lg">Privacy Policy</h1>
      <p class="mt-3 text-body-lg text-ink-muted">
        Your privacy is our highest priority. Learn how our client-side architecture keeps your financial trade data completely private.
      </p>
    </div>
  </section>

  <Section id="privacy-content" title="Client-Side Data Guarantee" tone="surface">
    <div class="max-w-prose space-y-6 text-body text-ink-muted">
      <Card title="1. Zero Server-Side Financial Data Storage" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          All calculation engines on <strong>risktorewardcalculator.com</strong> execute 100% locally within your web browser JavaScript runtime. Entry prices, stop loss targets, share quantities, capital amounts, broker settings, and trade statistics are never transmitted to, stored on, or processed by our web servers.
        </p>
      </Card>

      <Card title="2. Local Storage & Preferences" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          We may utilize standard browser <code class="text-caption font-mono text-ink">localStorage</code> or session storage to preserve your UI preferences (such as selected currency or default broker selection) across page refreshes. This data remains on your local device and can be cleared at any time via your browser settings.
        </p>
      </Card>

      <Card title="3. Server Logs & Web Analytics" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          Like virtually all web hosts, our server infrastructure records standard non-identifying access logs (such as IP address, browser user agent, referral pages, and timestamps) solely for network security, DDoS protection, uptime monitoring, and aggregate traffic telemetry.
        </p>
      </Card>

      <Card title="4. Third-Party Analytics & Cookies" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          We do not sell, trade, or rent user data to third-party ad networks or data brokers. If anonymized web analytics tools are utilized, they operate in strict compliance with data privacy regulations (GDPR / CCPA) and do not track individual financial activities.
        </p>
      </Card>

      <Card title="5. Data Protection Contact" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          If you have questions or concerns regarding our privacy practices or data handling, please reach out through our <a href="/contact/" class="text-ink underline decoration-hairline-strong underline-offset-2 hover:text-ink-muted">contact form</a>.
        </p>
      </Card>
    </div>
  </Section>
</BaseLayout>
