---
import Layout from "../layouts/BaseLayout.astro";
import Nav from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
---

<Layout
  title="Page Not Found — Risk Reward Calculator"
  description="That page doesn't exist. Jump to the risk reward calculator, win rate or stock average calculator instead."
  path="/404"
  noindex
>
  <main id="main" class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-48 h-[28rem] mesh-gradient opacity-35 dark:opacity-25"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-canvas/50 to-canvas"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative py-20 sm:py-28">
      <p class="font-mono text-caption uppercase tracking-widest text-mute">Error 404</p>
      <h1 class="mt-3 max-w-2xl text-display-lg text-ink sm:text-display-xl text-balance">
        That page doesn't exist.
      </h1>
      <p class="mt-5 max-w-xl text-body-lg text-body">
        The link may be out of date, or there may be a typo in the address. Everything the
        site does is one click away below.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">Back to the home page</a>
        <a href="/win-rate-calculator" class="btn btn-secondary">Open the win rate calculator</a>
        <a href="/stock-average-calculator" class="btn btn-secondary">Open the stock average calculator</a>
      </div>

      <div class="mt-16">
        <h2 class="text-heading-lg text-ink">Other pages on the site</h2>
      </div>


      </div>
  </main>
</Layout>
