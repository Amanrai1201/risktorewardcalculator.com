---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/site/Section.astro';
import Card from '../../components/ui/Card.astro';
import { breadcrumbs } from '../../lib/schema';

const title = 'Disclaimer & Financial Notice | Risk Reward Calculator';
const description =
  'Read our legal disclaimer. All calculators on Risk Reward Calculator are provided strictly for educational and informational purposes.';

const jsonLd = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Disclaimer', path: '/disclaimer/' },
  ]),
];
---

<BaseLayout {title} {description} path="/disclaimer/" {jsonLd}>
  <section class="container-page pt-8 pb-10 sm:pt-10 sm:pb-12">
    <div class="max-w-prose">
      <h1 class="text-display-lg">Disclaimer &amp; Financial Notice</h1>
      <p class="mt-3 text-body-lg text-ink-muted">
        Important notice regarding the use of our trading calculators, brokerage rate estimates, and educational content.
      </p>
    </div>
  </section>

  <Section id="notice" title="Legal Terms & Disclaimers" tone="surface">
    <div class="max-w-prose space-y-6 text-body text-ink-muted">
      <Card title="1. Informational & Educational Purpose Only" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          All calculators, estimation tools, formulas, data outputs, and articles provided on <strong>risktorewardcalculator.com</strong> are published strictly for general educational and calculation purposes. Nothing on this website constitutes financial, investment, trading, tax, or legal advice.
        </p>
      </Card>

      <Card title="2. No Financial Advisor or Intermediary Status" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          Risk Reward Calculator is an independent web application tool. We are not a broker, registered investment advisor (RIA), or SEBI-registered research analyst. We do not solicit orders, accept client funds, manage portfolios, or recommend specific stocks, options, forex pairs, or cryptocurrencies.
        </p>
      </Card>

      <Card title="3. Rate Card Estimates & Brokerage Calculations" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          Brokerage fees, Securities Transaction Tax (STT), Exchange Transaction Charges, SEBI turnover fees, Stamp Duty, GST, and Depository Participant (DP) charges generated by our calculator are estimates calculated from published rate cards. Actual charges applied by your broker or exchange may vary based on scrip group, order execution splitting, trade timing, and overnight carrying conditions.
        </p>
      </Card>

      <Card title="4. Trading Risk Acknowledgment" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          Trading equity, derivatives, forex, futures, and digital assets involves substantial capital risk. Past performance or theoretical break-even win rates do not guarantee future market outcomes. You are solely responsible for evaluating your risk tolerance and consulting a certified financial professional before making trading decisions.
        </p>
      </Card>

      <Card title="5. Limitation of Liability" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          Under no circumstances shall <strong>risktorewardcalculator.com</strong>, its creators, or operators be liable for any direct, indirect, incidental, consequential, or trading losses resulting from reliance on the formulas, tools, or information provided on this platform.
        </p>
      </Card>
    </div>
  </Section>
</BaseLayout>
