---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/site/Section.astro';
import Card from '../../components/ui/Card.astro';
import { breadcrumbs } from '../../lib/schema';

const title = 'Terms & Conditions | Risk Reward Calculator';
const description =
  'Read the Terms & Conditions governing the use of Risk Reward Calculator tools and web application.';

const jsonLd = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Terms & Conditions', path: '/terms-and-conditions/' },
  ]),
];
---

<BaseLayout {title} {description} path="/terms-and-conditions/" {jsonLd}>
  <section class="container-page pt-8 pb-10 sm:pt-10 sm:pb-12">
    <div class="max-w-prose">
      <h1 class="text-display-lg">Terms &amp; Conditions</h1>
      <p class="mt-3 text-body-lg text-ink-muted">
        Please read these terms carefully before using risktorewardcalculator.com.
      </p>
    </div>
  </section>

  <Section id="terms-content" title="Agreement to Terms" tone="surface">
    <div class="max-w-prose space-y-6 text-body text-ink-muted">
      <Card title="1. Acceptance of Terms" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          By accessing or using <strong>risktorewardcalculator.com</strong> ("the Website"), you agree to be bound by these Terms and Conditions. If you do not agree with any part of these terms, please discontinue use of the Website immediately.
        </p>
      </Card>

      <Card title="2. Permitted Use of Tools" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          Our Risk Reward Calculator, Win Rate Calculator, and Stock Average Calculator are provided for personal, non-commercial use. You agree not to attempt to reverse engineer, scrape, automatedly query, or exploit the underlying application logic for commercial gain without explicit prior written authorization.
        </p>
      </Card>

      <Card title="3. Intellectual Property Rights" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          All original source code, design layout, brand assets, algorithms, and written guide documentation on this Website are the exclusive intellectual property of risktorewardcalculator.com and are protected under global copyright and trademark laws.
        </p>
      </Card>

      <Card title="4. Service Availability & Modifications" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          We continuously update and refine our trading tools. We reserve the right to modify, suspend, or discontinue any feature, rate card data, or portion of the Website at any time without prior notice.
        </p>
      </Card>

      <Card title="5. Governing Law" headingLevel={3}>
        <p class="mt-2 text-body-sm text-ink-muted">
          These Terms shall be governed by and construed in accordance with applicable laws, without giving effect to any principles of conflicts of law.
        </p>
      </Card>
    </div>
  </Section>
</BaseLayout>
